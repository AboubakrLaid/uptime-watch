# Production runtime template
# Copy this file to .env.production and populate it with real values from your secret manager.
ENV=PROD
DEBUG=False
BACK_HOST=https://api.example.com
DJANGO_PORT=8000
DJANGO_SECRET_KEY=replace-with-a-real-production-secret
POSTGRES_DB=uptime_watch_prod
POSTGRES_USER=uptime_watch_prod
POSTGRES_PASSWORD=replace-with-a-real-db-password
DB_HOST=db.internal.example.com
DB_PORT=5432
ALLOWED_HOSTS=api.example.com,localhost
